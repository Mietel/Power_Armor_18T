<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.START_ACTIVITIES_FROM_BACKGROUND" />
    <uses-feature android:name="android.hardware.camera.any" android:required="false" />

    <application
        android:label="18T FLIR SDK Compat"
        android:allowBackup="false"
        android:hasCode="true"
        android:usesCleartextTraffic="false">

        <meta-data android:name="xposedmodule" android:value="true" />
        <meta-data android:name="xposeddescription" android:value="Power Armor 18T FLIR Mobile SDK INTEGRATED + RGB VisualBridge" />
        <meta-data android:name="xposedminversion" android:value="93" />

        <service
            android:name=".VisualBridgeService"
            android:process=":visualbridge"
            android:exported="true" />
    </application>
</manifest>
